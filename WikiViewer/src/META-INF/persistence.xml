<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence           http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
  <persistence-unit name="WikiViewerPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <class>model.Article</class>
    <class>model.Category</class>
    <class>model.Statistics</class>
    <class>model.Search</class>
    <properties>
      <property name="javax.persistence.jdbc.url" value="jdbc:derby:wikiDB"/>
      <property name="javax.persistence.jdbc.user" value="wiki"/>
      <property name="javax.persistence.jdbc.driver" value="org.apache.derby.jdbc.EmbeddedDriver"/>
      <property name="javax.persistence.jdbc.password" value="wiki"/>
    </properties>
  </persistence-unit>
</persistence>
